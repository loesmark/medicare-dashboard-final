# ═══════════════════════════════════════════════════════════
#  MediCare Backend — متغيرات البيئة
#  انسخ هذا الملف إلى ‎.env‎ وعدّل القيم حسب جهازك
# ═══════════════════════════════════════════════════════════

# ── قاعدة البيانات (SQLite) ──
# المسار الكامل لملف قاعدة البيانات. على جهازك الشخصي استخدم:
#   Windows: file:C:/medicare/custom.db
#   macOS/Linux: file:./db/custom.db
DATABASE_URL=file:./db/custom.db

# ─ـ JWT Secret (سرّي — ضعه قيمة عشوائية طويلة) ──
# لتوليد قيمة عشوائية، شغّل في الطرفية:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me

# ── مدة صلاحية JWT ──
JWT_EXPIRES_IN=7d

# ── رمز النسخ الاحتياطي (لتتمرير تنزيل قاعدة البيانات) ──
# افتراضي: admin-passcode (غيّره في الإنتاج)
ADMIN_BACKUP_PASSCODE=admin-passcode

# ── بيانات الأدمن الافتراضي (يستخدمها سكربت seed) ──
ADMIN_NAME=د. أحمد الطبيب
ADMIN_PHONE=01000000000
ADMIN_PASSWORD=admin123

# ── تيليجرام (اختياري — اتركها فارغة للتشغيل المحلي بدون تيليجرام) ──
# أنشئ بوت من @BotFather واحصل على التوكن، ثم أضف البوت لمجموعتك كـ admin
# واحصل على chat_id من @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_CHAT_ID=

# ── رقم واتساب الطبيب (لإنشاء روابط المحادثة) ──
# بصيغة دولية بدون + أو مسافات، مثال: 201000000000
DOCTOR_WHATSAPP_NUMBER=201000000000

# ── بيئة التشغيل ──
NODE_ENV=development
