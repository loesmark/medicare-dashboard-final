# ═══════════════════════════════════════════════════════════
#  MediCare Backend — متغيرات البيئة
#  انسخ هذا الملف إلى ‎.env‎ وعدّل القيم حسب جهازك
# ═══════════════════════════════════════════════════════════

# ── Turso (مطلوب للإنتاج على Render) ──
# احصل عليها عبر:
#   turso db show medicare --url
#   turso db tokens create medicare
TURSO_DATABASE_URL=libsql://medicare-<your-username>.turso.io
TURSO_AUTH_TOKEN=

# ── للتطوير المحلي فقط (اختياري) ──
# اترك هذا فارغاً على Render — فقط للاستخدام المحلي بدون Turso.
DATABASE_URL=file:./db/custom.db

# ── JWT Secret (سرّي — ضعه قيمة عشوائية طويلة) ──
# لتوليد قيمة عشوائية، شغّل في الطرفية:
#   openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me

# ── رمز النسخ الاحتياطي (لتتمرير تنزيل قاعدة البيانات) ──
ADMIN_BACKUP_PASSCODE=admin-passcode

# ── بيانات الأدمن الافتراضي (يستخدمها سكربت seed) ──
ADMIN_NAME=د. أحمد الطبيب
ADMIN_PHONE=01000000000
ADMIN_PASSWORD=admin123

# ── تيليجرام (اختياري — يُضبط لاحقاً من لوحة الأدمن) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_CHAT_ID=

# ── رقم واتساب الطبيب ──
DOCTOR_WHATSAPP_NUMBER=201000000000

# ── بيئة التشغيل ──
NODE_ENV=development
